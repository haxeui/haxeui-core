    var Resource = 85;
    var AnimationName = 86;
    var AnimationDuration = 87;
    var AnimationTimingFunction = 88;
    var AnimationDelay = 89;
    var AnimationIterationCount = 90;
    var AnimationDirection = 91;
    var AnimationFillMode = 92;
    var Mode = 93;
    var PointerEvents = 94;
    var ContentType = 95;
    var Direction = 96;
    var ScaleMode = 97;
    var ContentWidth = 98;
    var ContentHeight = 99;
    var WordWrap = 100;
    var ImageRendering = 101;
    var Layout = 102;
    var IncludeInLayout = 103;
    var JustifyContent = 104;

    static final ids:Map<String, Int> = [
        "left" => 0,
        "top" => 1,
